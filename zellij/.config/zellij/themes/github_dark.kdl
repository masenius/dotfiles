// GitHub Dark Zellij Theme
// Based on GitHub's Primer dark color palette
// Add this file to your `CONFIG_DIR/themes` directory as described here:
// https://zellij.dev/documentation/themes#getting-zellij-to-pick-up-the-theme

themes {
    github_dark {
        text_unselected {
            base 230 237 243
            background 13 17 23
            emphasis_0 248 81 73
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 88 166 255
        }
        text_selected {
            base 13 17 23
            background 230 237 243
            emphasis_0 255 123 114
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 88 166 255
        }
        ribbon_selected {
            base 13 17 23
            background 230 237 243
            emphasis_0 255 123 114
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 88 166 255
        }
        ribbon_unselected {
            base 139 148 158
            background 13 17 23
            emphasis_0 110 118 129
            emphasis_1 13 17 23
            emphasis_2 110 118 129
            emphasis_3 110 118 129
        }
        table_title {
            base 88 166 255
            background 13 17 23
            emphasis_0 255 123 114
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 188 140 255
        }
        table_cell_selected {
            base 230 237 243
            background 22 27 34
            emphasis_0 255 123 114
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 88 166 255
        }
        table_cell_unselected {
            base 230 237 243
            background 13 17 23
            emphasis_0 255 123 114
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 88 166 255
        }
        list_selected {
            base 230 237 243
            background 22 27 34
            emphasis_0 255 123 114
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 88 166 255
        }
        list_unselected {
            base 230 237 243
            background 13 17 23
            emphasis_0 255 123 114
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 88 166 255
        }
        frame_selected {
            base 88 166 255
            background 0
            emphasis_0 255 123 114
            emphasis_1 63 185 80
            emphasis_2 210 153 34
            emphasis_3 0
        }
        frame_highlight {
            base 240 136 62
            background 0
            emphasis_0 240 136 62
            emphasis_1 240 136 62
            emphasis_2 240 136 62
            emphasis_3 240 136 62
        }
        exit_code_success {
            base 63 185 80
            background 0
            emphasis_0 57 211 83
            emphasis_1 13 17 23
            emphasis_2 210 153 34
            emphasis_3 88 166 255
        }
        exit_code_error {
            base 248 81 73
            background 0
            emphasis_0 210 153 34
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 188 140 255
            player_2 88 166 255
            player_3 57 211 83
            player_4 210 153 34
            player_5 57 197 207
            player_6 248 81 73
            player_7 240 136 62
            player_8 0
            player_9 0
            player_10 0
        }
    }
}
